// Cloudflare Workers static-assets config for the public Camply website.
// The site is pre-built into frontend/dist/ by `python backend/manage.py build_frontend`
// and committed, so Cloudflare needs no build step: it just runs `npx wrangler deploy`.
{
  "name": "camply",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "404-page"
  }
}

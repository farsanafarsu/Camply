# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.camply.in

# MongoDB (local Docker, or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=camply

# Redis for Celery background jobs. Leave empty in development to run jobs inline.
REDIS_URL=

# Encrypts ad platform tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Email verification on sign-up: mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Camply <no-reply@camply.app>

# Sign in with Google / Microsoft (optional; buttons appear only when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Ad platforms
CAMPLY_SANDBOX_ADAPTERS=true
META_GRAPH_API_VERSION=v23.0

# Payments, AI, storage (later phases)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ANTHROPIC_API_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=

CAMPLY_SUPPLIER_STATE=Kerala

# Password for the demo users created by `python manage.py seed_demo`
CAMPLY_DEMO_PASSWORD=
